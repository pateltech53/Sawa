# Copy to .env.local (never commit real keys). On Vercel, set these in Project → Settings → Environment Variables.

# Ask Sawa + document reading. Without a key, Sawa runs in retrieval-only demo mode.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
SAWA_MODEL=
# Set to 1 to force cached/retrieval answers (venue Wi-Fi backup)
DEMO_MODE=

# Pilot backend (schema in supabase/migrations). Service key stays server-side only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
